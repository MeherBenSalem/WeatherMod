{
  "schemaVersion": 1,
  "id": "livingworld",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "icon": "assets/livingworld/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.livingworld.fabric.LivingWorldFabric"],
    "client": ["dev.livingworld.fabric.client.LivingWorldFabricClient"],
    "modmenu": ["dev.livingworld.fabric.compat.ModMenuIntegration"]
  },
  "mixins": [
    "livingworld.mixins.json",
    {
      "config": "livingworld.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
